# ====================================================================
# LOCAL COLD-STORAGE DATA VOLUMES (Crucial for 8GB RAM local boundaries)
# ====================================================================
# Exclude raw financial datasets, legal contract text fragments, and test PDFs
data/
*.pdf
*.txt
*.csv
*.tsv
*.json

# Un-ignore template files if needed for explicit reference structure
!src/dbt_pipeline/models/staging/*.sql
!src/dbt_pipeline/models/marts/*.sql

# ====================================================================
# MACHINE LEARNING SERIALIZED WEIGHTS & EMBEDDINGS
# ====================================================================
# Exclude heavy trained LightGBM models, Scikit-Learn vectorizer pickles, and encoders
src/ml/models/lightgbm_finrisk.model
src/ml/models/*.pkl
*.model
*.pkl
*.bst
*.onnx

# MLflow Tracking Metrics and System Artifacts Cache
mlruns/
.mlflow/
mlflow.db

